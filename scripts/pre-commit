#!/usr/bin/env bash
# Format staged CSS/JS/HTML with Prettier and Python with Ruff before commit.
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:${HOME}/.local/bin:${PATH}"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

prettier_files=()
ruff_files=()

while IFS= read -r f; do
  [[ -z "$f" || ! -f "$f" ]] && continue
  case "$f" in
    *.css | *.js | *.html | *.htm | *.json) prettier_files+=("$f") ;;
    *.py) ruff_files+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if ((${#prettier_files[@]})); then
  if command -v prettier >/dev/null 2>&1; then
    prettier --write -- "${prettier_files[@]}"
  elif command -v npx >/dev/null 2>&1; then
    npx --yes prettier@3 --write -- "${prettier_files[@]}"
  else
    echo "pre-commit: prettier/npx not found; skip CSS/JS/HTML format" >&2
  fi
  git add -- "${prettier_files[@]}"
fi

if ((${#ruff_files[@]})); then
  if command -v ruff >/dev/null 2>&1; then
    ruff format -- "${ruff_files[@]}"
    ruff check --fix -- "${ruff_files[@]}"
  elif command -v uvx >/dev/null 2>&1; then
    uvx ruff format -- "${ruff_files[@]}"
    uvx ruff check --fix -- "${ruff_files[@]}"
  else
    echo "pre-commit: ruff/uvx not found; skip Python format" >&2
  fi
  git add -- "${ruff_files[@]}"
fi
